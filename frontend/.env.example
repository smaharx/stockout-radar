# Backend origin only. Do not add /api/v1 to this value.
# The browser calls the same-origin Next.js proxy; this URL stays server-side.
STOCKOUT_RADAR_API_URL=http://127.0.0.1:8001

# Server-only deployment settings. Never commit real values.
STOCKOUT_RADAR_API_KEY=
STOCKOUT_RADAR_ADMIN_USER=
STOCKOUT_RADAR_ADMIN_PASSWORD=
