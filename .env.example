# Local development uses SQLite by default when DATABASE_URL is omitted.
# For Neon, paste the connection string from the Neon dashboard here.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local development mode. Set production in the hosting environment.
APP_ENV=local

# Leave blank locally. Configure a generated secret in Vercel.
STOCKOUT_RADAR_API_KEY=
